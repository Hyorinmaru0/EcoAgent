# Existing optional chatbot integration:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required for the embedded Google Map in Facility Directory. Restrict the key
# to this website in Google Cloud; the map stays unavailable until configured.
VITE_GOOGLE_MAPS_API_KEY=

# Use a Python environment with ml/tv_training/requirements.txt installed
# (onnxruntime, numpy, Pillow). The matching best.onnx is used automatically.
# Windows example: C:/Users/your-name/YOLO_TV/yolo-env/Scripts/python.exe
# If omitted, the server tries .venv, then python on PATH.
TV_DETECTOR_PYTHON=
DEVICE_DETECTOR_WEIGHTS=ml/device_detection/weights/best.pt
# Installed separately by scripts/setup-reference-detector.py; original weights stay intact.
REFERENCE_DETECTOR_WEIGHTS=ml/device_detection/reference/yolo11m.onnx
TV_DETECTOR_WEIGHTS=ml/tv_training/weights/best.pt
# Optional; runs only when this file (or its matching .onnx) exists.
DAMAGE_DETECTOR_WEIGHTS=ml/damage_detection/weights/best.pt
# The locally promoted Round 2 model uses this path when installed; keep its policy sidecar:
# DAMAGE_DETECTOR_WEIGHTS=ml/condition_training/weights/round2-binary-20261105/best.pt
